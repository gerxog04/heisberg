{
  "version": 2,
  "functions": {
    "api/*.ts": {
      "runtime": "nodejs20.x",
      "includeFiles": "node_modules/@google/genai/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" },
    { "source": "/v2/:path*", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}