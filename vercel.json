{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "runtime": "now-node@20.x"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/v2/:path*", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}